generator client {
  provider        = "prisma-client-js"
  // Driver `pg` no lugar do motor nativo: uma ida e volta por consulta no pooler do Supabase
  previewFeatures = ["driverAdapters"]
  // native: este PC; rhel-openssl-3.0.x: funções da Vercel (Linux)
  binaryTargets   = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  EMPLOYEE
  ADMIN
}

model User {
  id             String   @id @default(uuid())
  name           String
  email          String   @unique
  password       String
  role           UserRole
  active         Boolean  @default(true)
  /// Incrementado na troca de senha: tokens com versão diferente são rejeitados.
  tokenVersion   Int      @default(0) @map("token_version")
  /// Recebe os lembretes de entrada e saída por e-mail (quando o SMTP está configurado).
  emailReminders Boolean  @default(true) @map("email_reminders")
  workScheduleId String?  @map("work_schedule_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  workSchedule            WorkSchedule?      @relation(fields: [workScheduleId], references: [id])
  punchClocks             PunchClock[]       @relation("PunchOwner")
  createdPunches          PunchClock[]       @relation("PunchCreatedBy")
  voidedPunches           PunchClock[]       @relation("PunchVoidedBy")
  absences                Absence[]          @relation("AbsenceOwner")
  createdAbsences         Absence[]          @relation("AbsenceCreatedBy")
  canceledAbsences        Absence[]          @relation("AbsenceCanceledBy")
  scheduleHistory         ScheduleHistory[]
  hourBankEntries         HourBankEntry[]    @relation("HourBankOwner")
  createdHourBankEntries  HourBankEntry[]    @relation("HourBankCreatedBy")
  canceledHourBankEntries HourBankEntry[]    @relation("HourBankCanceledBy")
  pushSubscriptions       PushSubscription[]
  pushReminders           PushReminder[]

  @@map("users")
}

/// Aparelho (navegador) que aceitou receber os lembretes de entrada e saída.
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  /// Endereço do serviço de push do navegador: identifica o aparelho.
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

/// Lembrete já enviado: um de cada tipo por funcionário e dia.
model PushReminder {
  userId String   @map("user_id")
  /// Data local (YYYY-MM-DD, no fuso APP_TIMEZONE).
  date   String
  /// entry = hora de bater a entrada; exit = hora de registrar a saída.
  kind   String
  sentAt DateTime @default(now()) @map("sent_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, date, kind])
  @@map("push_reminders")
}

model WorkSchedule {
  id                       String @id @default(uuid())
  name                     String
  /// Horário previsto de início da jornada (HH:mm, no fuso APP_TIMEZONE).
  startTime                String @map("start_time")
  /// Minutos de trabalho esperados por dia de trabalho.
  dailyMinutes             Int    @map("daily_minutes")
  /// Dias de trabalho: 0 = domingo ... 6 = sábado.
  workDays                 Int[]  @map("work_days")
  /// Atrasos até este limite não são computados.
  lateToleranceMinutes     Int    @default(10) @map("late_tolerance_minutes")
  /// Diferenças diárias (extra ou falta) até este limite não são computadas.
  overtimeToleranceMinutes Int    @default(10) @map("overtime_tolerance_minutes")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  users   User[]
  history ScheduleHistory[]

  @@map("work_schedules")
}

/// Jornada vigente de um funcionário a partir de uma data, com cópia dos valores da época:
/// trocar a jornada ou editá-la não muda o cálculo dos dias anteriores.
/// Sem workScheduleId (e campos nulos) = sem jornada a partir dessa data.
model ScheduleHistory {
  id             String  @id @default(uuid())
  userId         String  @map("user_id")
  /// Data local (YYYY-MM-DD) a partir da qual vale.
  effectiveFrom  String  @map("effective_from")
  workScheduleId String? @map("work_schedule_id")

  startTime                String? @map("start_time")
  dailyMinutes             Int?    @map("daily_minutes")
  workDays                 Int[]   @map("work_days")
  lateToleranceMinutes     Int?    @map("late_tolerance_minutes")
  overtimeToleranceMinutes Int?    @map("overtime_tolerance_minutes")

  createdAt DateTime @default(now()) @map("created_at")

  user         User          @relation(fields: [userId], references: [id])
  workSchedule WorkSchedule? @relation(fields: [workScheduleId], references: [id], onDelete: SetNull)

  @@unique([userId, effectiveFrom])
  @@map("schedule_history")
}

/// Feriado da empresa: num dia de trabalho, não gera falta e todo o tempo trabalhado conta como extra.
model Holiday {
  id   String @id @default(uuid())
  /// Data local (YYYY-MM-DD, no fuso APP_TIMEZONE).
  date String @unique
  name String

  createdAt DateTime @default(now()) @map("created_at")

  @@map("holidays")
}

enum AbsenceType {
  MEDICAL
  VACATION
  LEAVE
  ALLOWANCE
  /// Folga de banco: consome do banco de horas a carga prevista do dia.
  COMPENSATION
}

/// Abono, atestado, férias ou afastamento de dias inteiros. Nos dias de trabalho
/// cobertos não há horas previstas nem falta. Nunca é apagado: o cancelamento fica registrado.
model Absence {
  id        String      @id @default(uuid())
  userId    String      @map("user_id")
  type      AbsenceType
  /// Período inclusivo, datas locais (YYYY-MM-DD, no fuso APP_TIMEZONE).
  startDate String      @map("start_date")
  endDate   String      @map("end_date")
  reason    String

  createdAt   DateTime @default(now()) @map("created_at")
  createdById String   @map("created_by_id")

  canceledAt   DateTime? @map("canceled_at")
  canceledById String?   @map("canceled_by_id")

  user       User  @relation("AbsenceOwner", fields: [userId], references: [id])
  createdBy  User  @relation("AbsenceCreatedBy", fields: [createdById], references: [id])
  canceledBy User? @relation("AbsenceCanceledBy", fields: [canceledById], references: [id])

  @@index([userId, startDate])
  @@map("absences")
}

enum PunchSource {
  EMPLOYEE
  ADMIN
}

/// Local de trabalho: marcações fora do raio de todos os locais recebem alerta (nunca são recusadas).
model Workplace {
  id           String @id @default(uuid())
  name         String
  latitude     Float
  longitude    Float
  radiusMeters Int    @map("radius_meters")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  @@map("workplaces")
}

/// INSIDE = dentro do raio de um local; OUTSIDE = fora de todos;
/// UNAVAILABLE = o aparelho não enviou a localização (permissão negada, sem GPS).
enum PunchLocationStatus {
  INSIDE
  OUTSIDE
  /// Margem de erro do GPS tão grande que não dá para dizer se estava no local
  IMPRECISE
  UNAVAILABLE
}

/// Marcação de ponto. Marcações nunca são apagadas nem alteradas:
/// correções desconsideram a original (voided*) e incluem uma nova (source = ADMIN).
model PunchClock {
  id        String      @id @default(uuid())
  userId    String
  timestamp DateTime    @default(now()) @db.Timestamptz(3)
  source    PunchSource @default(EMPLOYEE)

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById String?  @map("created_by_id")
  /// Justificativa da inclusão manual.
  reason      String?
  /// Marcação que esta inclusão substitui.
  replacesId  String?  @map("replaces_id")

  /// Localização enviada pelo aparelho no momento da marcação (só marcações do funcionário).
  latitude       Float?
  longitude      Float?
  /// Margem de erro informada pelo aparelho, em metros.
  accuracyMeters Float?               @map("accuracy_meters")
  /// Avaliação na hora da marcação; null = sem local cadastrado ou inclusão do admin.
  locationStatus PunchLocationStatus? @map("location_status")
  /// Local mais próximo e a distância até ele, guardados como eram na hora da marcação.
  workplaceName  String?              @map("workplace_name")
  distanceMeters Int?                 @map("distance_meters")
  /// Endereço aproximado da localização (OpenStreetMap), gravado na hora da marcação.
  address        String?

  /// Batida feita sem internet: o horário veio do aparelho e chegou depois (createdAt = recebimento).
  offline  Boolean @default(false)
  /// Identificador gerado pelo aparelho na batida offline: o reenvio não grava duas vezes.
  clientId String? @unique @map("client_id")

  voidedAt   DateTime? @map("voided_at") @db.Timestamptz(3)
  voidedById String?   @map("voided_by_id")
  voidReason String?   @map("void_reason")

  user       User         @relation("PunchOwner", fields: [userId], references: [id])
  createdBy  User?        @relation("PunchCreatedBy", fields: [createdById], references: [id])
  voidedBy   User?        @relation("PunchVoidedBy", fields: [voidedById], references: [id])
  replaces   PunchClock?  @relation("PunchReplacement", fields: [replacesId], references: [id])
  replacedBy PunchClock[] @relation("PunchReplacement")

  @@index([userId, timestamp])
  @@map("punch_clocks")
}

/// Ajuste manual do banco de horas (ex.: horas extras pagas em folha, crédito acordado).
/// Nunca é apagado: o cancelamento fica registrado.
model HourBankEntry {
  id      String @id @default(uuid())
  userId  String @map("user_id")
  /// Data local (YYYY-MM-DD) em que o ajuste entra no saldo.
  date    String
  /// Positivo = crédito; negativo = débito.
  minutes Int
  reason  String

  createdAt   DateTime @default(now()) @map("created_at")
  createdById String   @map("created_by_id")

  canceledAt   DateTime? @map("canceled_at")
  canceledById String?   @map("canceled_by_id")

  user       User  @relation("HourBankOwner", fields: [userId], references: [id])
  createdBy  User  @relation("HourBankCreatedBy", fields: [createdById], references: [id])
  canceledBy User? @relation("HourBankCanceledBy", fields: [canceledById], references: [id])

  @@index([userId, date])
  @@map("hour_bank_entries")
}
