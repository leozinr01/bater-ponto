# Copie para .env e preencha. O .env nunca vai para o Git.

# Porta HTTP da API
PORT=3333
NODE_ENV=development

# PostgreSQL. Escolha um:
# - Local (docker compose up -d):
DATABASE_URL=postgresql://ponto:ponto@localhost:5432/ponto?schema=public
# - Supabase: Connect > Connection string > Session pooler (5432) ou Transaction pooler (6543).
#   Caracteres especiais da senha precisam ser codificados na URL (ex.: @ vira %40).
# DATABASE_URL=postgresql://postgres.<id-do-projeto>:<senha>@aws-1-<regiao>.pooler.supabase.com:6543/postgres

# Segredo para assinar os tokens JWT (mínimo 32 caracteres). Gere um com:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Fuso que define o "dia" de trabalho e interpreta os horários das jornadas
APP_TIMEZONE=America/Sao_Paulo

# Origens liberadas para CORS, separadas por vírgula (vazio = CORS desligado).
# Necessário quando o front fica em outro domínio, ex.: https://ponto-tai.vercel.app
CORS_ORIGIN=

# Documentação interativa em /swagger. Deixe false (ou sem a variável) em produção
SWAGGER_ENABLED=true
