# URL base da API usada pelo front em produção (build).
# Em desenvolvimento deixe vazio: o Vite encaminha /api para http://localhost:3333.
VITE_API_URL=

# Endereço público do app usado no QR code de instalação.
# Vazio = o próprio endereço aberto no navegador (o normal depois do deploy).
VITE_PUBLIC_URL=
